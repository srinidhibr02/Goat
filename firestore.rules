rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Temples ───────────────────────────────────────────────────────────────
    // Public read; only admins can write.
    match /temples/{templeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Feed ──────────────────────────────────────────────────────────────────
    // Public read; only admins can create/update/delete posts.
    match /feed/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Each user can read/write their own document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Bookings sub-collection — user owns their bookings.
      match /bookings/{bookingId} {
        allow read, write: if isOwner(uid);
      }

      // Favorites sub-collection.
      match /favorites/{templeId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
